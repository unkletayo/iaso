{
  "name": "iaso",
  "version": "0.0.1",
  "description": "Iaso: a minimal coding agent that heals broken code.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "iaso": "./dist/cli.js"
  },
  "files": [
    "dist",
    "models.json"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "commander": "^15.0.0",
    "dockerode": "^5.0.1",
    "openai": "^7.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": ">=6.0 <6.1",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
