{
  "name": "iaso",
  "version": "0.0.1",
  "description": "Iaso: a minimal coding agent that heals broken code.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "iaso": "./dist/cli.js"
  },
  "workspaces": [
    "ui"
  ],
  "files": [
    "dist",
    "models.json",
    "ui/dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:web": "npm -w ui run dev",
    "build": "npm -w ui run build && tsc -p tsconfig.build.json",
    "build:backend": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && npm -w ui run typecheck",
    "lint": "eslint . --quiet",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepare": "husky"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "commander": "^15.0.0",
    "dockerode": "^5.0.1",
    "fastify": "^5.4.0",
    "openai": "^7.34.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.5.14",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": ">=6.0 <6.1",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
