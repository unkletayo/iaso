# Iaso reads these from the environment (it does not load .env files itself).
# Export them in your shell, e.g. `set -a; source .env; set +a`.
# Set only the providers you use. Run `iaso models` to see which are detected.
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
OPENROUTER_API_KEY=your-openrouter-key
GEMINI_API_KEY=your-gemini-key

# Optional: raises the GitHub rate limit and allows private repos for --github.
GITHUB_TOKEN=your-github-token

# Docker Desktop on macOS: point at the user socket.
# DOCKER_HOST=unix://$HOME/.docker/run/docker.sock
